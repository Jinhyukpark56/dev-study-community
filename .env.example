# Activate only after a PostgreSQL database is ready.
SPRING_PROFILES_ACTIVE=prod
PORT=8080

DB_HOST=replace-with-database-host
DB_PORT=5432
DB_NAME=dev_study_community
DB_USERNAME=dev_study_community
DB_PASSWORD=replace-with-a-secret
DB_POOL_SIZE=5
DB_SSL_MODE=require

# Keep true behind an HTTPS endpoint. Use false only for a local HTTP check.
SESSION_COOKIE_SECURE=true
SESSION_TIMEOUT=30m

# Temporary v0.1 preview setting. Move to validate after versioned migrations are added.
JPA_DDL_AUTO=update
